# ============================================================
# BLINDADO USA — Variables de entorno
# Copiar este archivo como .env.local y completar los valores.
# NO commitear .env.local
# ============================================================

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Plaid — https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@blindadousa.com
RESEND_FROM_NAME=BlindadoUSA

# App
NEXT_PUBLIC_APP_URL=https://blindadousa.com
NEXT_PUBLIC_APP_NAME=BlindadoUSA

# Crons (proteger endpoints de cron Vercel)
CRON_SECRET=
