# ============================================================
# BLINDADO USA — Variables de entorno
# Copiar este archivo como .env.local y completar los valores.
# NO commitear .env.local
# ============================================================

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Banana 2 (Nano Banana 2) — fondos 4K vía Gemini API
# https://aistudio.google.com/apikey · npm run images:banana2
GEMINI_API_KEY=

# Pagos — PayPal + Klarna (recomendado) · Lemon Squeezy o Stripe (fallback tarjeta)
# PayPal va directo a tu cuenta Business. Klarna = cuotas para el cliente.

# PayPal — https://developer.paypal.com/dashboard/applications/live
PAYPAL_MODE=live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Botones alojados PayPal (Hosted Button ID)
PAYPAL_HOSTED_BUTTON_MENSUAL=LL5F7EW8C7FFQ
PAYPAL_HOSTED_BUTTON_ANUAL=6FBGBVWZ9ASN8
# O planes API clásicos (P-...) si no usas hosted button
PAYPAL_PLAN_MENSUAL=
PAYPAL_PLAN_ANUAL=
PAYPAL_PLAN_MENSUAL_REF=
PAYPAL_PLAN_ANUAL_REF=
# Webhook: https://blindadousa.com/api/paypal/webhook
# Webhook ID (PayPal Developer → Apps → tu app → Webhooks → ID)
PAYPAL_WEBHOOK_ID=

# Klarna — https://portal.klarna.com (Merchant portal, US)
KLARNA_REGION=na
KLARNA_USERNAME=
KLARNA_PASSWORD=
# Webhook secret (Klarna Merchant Portal → Webhooks)
KLARNA_WEBHOOK_SECRET=

# Lemon Squeezy (alternativa tarjeta si PayPal/Klarna no aplican)
PAYMENT_PROVIDER=lemonsqueezy

# Lemon Squeezy — Settings → API + Store + Products
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MENSUAL=
LEMONSQUEEZY_VARIANT_ANUAL=
# Opcional: variantes con precio referido ($15/mes, etc.)
LEMONSQUEEZY_VARIANT_MENSUAL_REF=
LEMONSQUEEZY_VARIANT_ANUAL_REF=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Stripe (solo si mantienes clientes legacy)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Plaid — https://dashboard.plaid.com/team/keys
# Encryption key para tokens (generar: openssl rand -hex 32)
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Transfer ACH para comisiones de referidos ($5)
PLAID_TRANSFER_ENABLED=false
# Opcional: secret dedicado si Plaid lo provee para Transfer
PLAID_TRANSFER_SECRET=

# Emails con acceso a /dashboard/admin/directorio (separados por coma)
ADMIN_EMAILS=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@blindadousa.com
RESEND_FROM_NAME=BlindadoUSA

# App
NEXT_PUBLIC_APP_URL=https://blindadousa.com
NEXT_PUBLIC_APP_NAME=BlindadoUSA

# Twilio WhatsApp — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Crons (proteger endpoints de cron Vercel)
CRON_SECRET=


